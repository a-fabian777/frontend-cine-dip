FROM node:22.14.0

ENV NODE_ENV=development

WORKDIR /app

COPY --chown=1000:1000 package*.json .

RUN npm ci --legacy-peer-deps

RUN chown -R 1000:1000 ./node_modules

COPY --chown=1000:1000 . .

EXPOSE 5173

CMD ["npx", "vite", "--mode", "dev", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]





